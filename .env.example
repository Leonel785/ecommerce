# Copia este archivo como ".env" y completa los valores. ".env" está en .gitignore.
DB_URL=jdbc:mysql://localhost:3306/ecommerce?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=cambia_esta_contrasena

# Claves de 32 bytes en Base64 (generar cada una con el comando del README). DEBEN ser distintas.
APP_CRYPTO_KEY=
APP_HMAC_KEY=

# Opcional: contraseña inicial del admin (si se omite, se genera una aleatoria y se muestra en el log)
ADMIN_PASSWORD=
# Opcional: crea un cliente de demostración con contraseña aleatoria
SEED_DEMO_USER=false
# true cuando se sirva por HTTPS
COOKIE_SECURE=false
